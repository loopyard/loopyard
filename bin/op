#!/bin/bash
# Operator CLI for BoomLooper
# Usage: bin/op <command> [args]
set -e

# --- Config ---
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR"

# Load environment (eval to expand $PWD etc.)
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

BOOMLOOPER_HOME="${BOOMLOOPER_HOME:-$HOME/.boomlooper}"
COOKIE_FILE="$BOOMLOOPER_HOME/cookie"
MIX_HOME="${MIX_HOME:-$SCRIPT_DIR/.mix_home}"
HEX_HOME="${HEX_HOME:-$SCRIPT_DIR/.hex_home}"
HOSTNAME="$(hostname -s)"
NODE="boom@$HOSTNAME"

# Unique sname per invocation
SNAME="op_$(date +%s)_$$"

if [ ! -f "$COOKIE_FILE" ]; then
  echo "Error: Cookie not found at $COOKIE_FILE"
  echo "Is BoomLooper running? Start with: mix phx.server"
  exit 1
fi

COOKIE="$(cat "$COOKIE_FILE")"

rpc() {
  HOME=/tmp MIX_HOME="$MIX_HOME" HEX_HOME="$HEX_HOME" \
    elixir --sname "$SNAME" --cookie "$COOKIE" -e "$1" 2>&1
}

# --- Commands ---

case "${1:-help}" in
  connect)
    NAME="${2:-Operator}"
    rpc "
      result = :rpc.call(:\"$NODE\", BoomLooper.IExSession, :watching, [\"$NAME connected\"])
      case result do
        :ok -> IO.puts(\"Connected as $NAME (green)\")
        other -> IO.puts(\"Error: #{inspect(other)}\")
      end
    "
    ;;

  working)
    MSG="${2:-Working...}"
    rpc "
      :rpc.call(:\"$NODE\", BoomLooper.IExSession, :working, [\"$MSG\"])
      IO.puts(\"Status: working — $MSG (yellow)\")
    "
    ;;

  danger)
    MSG="${2:-Destructive operation}"
    rpc "
      :rpc.call(:\"$NODE\", BoomLooper.IExSession, :destructive, [\"$MSG\"])
      IO.puts(\"Status: danger — $MSG (red)\")
    "
    ;;

  disconnect)
    rpc "
      :rpc.call(:\"$NODE\", BoomLooper.IExSession, :disconnect, [])
      IO.puts(\"Disconnected\")
    "
    ;;

  status)
    rpc "
      state = :rpc.call(:\"$NODE\", BoomLooper.IExSession, :current, [])
      if state.level do
        IO.puts(\"#{state.level} — #{state.label} (#{state.node})\")
      else
        IO.puts(\"No operator connected\")
      end
    "
    ;;

  eval)
    shift
    PROJECT_PATH="${1:?Usage: bin/op eval <path> [--wipe]}"
    PROJECT_PATH="$(cd "$PROJECT_PATH" 2>/dev/null && pwd || echo "$PROJECT_PATH")"
    WIPE=false
    for arg in "$@"; do
      [ "$arg" = "--wipe" ] && WIPE=true
    done

    echo "Running eval on $PROJECT_PATH (wipe=$WIPE)..."

    rpc "
      :rpc.call(:\"$NODE\", BoomLooper.IExSession, :working, [\"Running eval\"])

      result = :rpc.call(:\"$NODE\", BoomLooper.EvalRunner, :run, [
        \"$PROJECT_PATH\",
        [clean: $WIPE, timeout: 900_000]
      ])

      :rpc.call(:\"$NODE\", BoomLooper.IExSession, :watching, [\"Eval complete\"])

      case result do
        {:ok, r} ->
          IO.puts(\"Outcome: #{r.outcome}\")
          IO.puts(\"Duration: #{div(r.duration_ms, 1000)}s\")
          IO.puts(\"Messages: #{r.message_count}\")
          IO.puts(\"Tools: #{r.tool_calls}\")
          IO.puts(\"Errors: #{r.errors}\")
          IO.puts(\"Nudges: #{r.nudges}\")
        {:error, reason} ->
          IO.puts(\"Error: #{reason}\")
      end
    "
    ;;

  projects)
    rpc "
      projects = :rpc.call(:\"$NODE\", BoomLooper.ProjectRegistry, :list_projects, [])
      Enum.each(projects, fn p ->
        IO.puts(\"#{p.id} | #{p.name} | #{p.path}\")
      end)
    "
    ;;

  agents)
    rpc "
      agents = :rpc.call(:\"$NODE\", BoomLooper.ChatAgent, :list_agents, [])
      Enum.each(agents, fn a ->
        IO.puts(\"#{a.id} | #{a.name} | #{a.status} | msgs=#{length(a[:messages] || [])} | tools=#{a[:tool_calls] || 0}\")
      end)
    "
    ;;

  recompile)
    rpc "
      result = :rpc.call(:\"$NODE\", IEx.Helpers, :recompile, [])
      IO.inspect(result)
    "
    ;;

  help|*)
    cat <<HELP
bin/op — BoomLooper operator CLI

  connect [name]       Connect as operator (green indicator in UI)
  working "message"    Set working status (yellow indicator)
  danger "message"     Set danger status (red indicator)
  disconnect           Disconnect (indicator disappears)
  status               Show current operator status

  eval <path> [--wipe] Run setup eval on a project
  projects             List registered projects
  agents               List running agents
  recompile            Recompile code on running node

HELP
    ;;
esac
