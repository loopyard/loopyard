# Hive Environment Configuration
# Copy to .env and customize. Values here are loaded automatically in dev/test.

# HTTP Basic Auth (optional — leave blank to disable)
# HIVE_AUTH_PASSWORD=changeme
# HIVE_AUTH_USERNAME=admin

# Production only:
# SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
# PHX_HOST=hive.example.com
# PORT=4000
