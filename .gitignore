# Dependencies and build
/deps
/_build
/.mix_home
/.hex_home
/.mix
/.hex

# Static artifacts
/priv/static/assets/

# Editor
.elixir_ls/

# Claude Code local settings
.claude/settings.local.json

# Environment (never commit secrets)
.env
.env.*
.envrc
!.env.example

# SSH host keys for the embedded SSH server (private — never commit)
/ssh/

# Build cache
/.cache

# Loopyard workspace (generated per-workspace files)
.loopyard/

# Loopyard home dir for test env
.loopyard_home/

# Loopyard local dev server state
.loopyard_dev/

# Loopyard per-workspace state when developing in-tree (never tracked)
/workspaces/

# Erlang crash dumps
erl_crash.dump

# Eval project clones (large, machine-local)
evals/*/project/

# OS
.DS_Store

# Eval projects (the actual repos being tested)
evals/*/project/
projects.json

/tmp/

ports.json
worktrees/

.claude/scheduled_tasks.lock
*.log
sagas.log

# Legacy paths from the BoomLooper→Loopyard rename — kept so leftover dirs
