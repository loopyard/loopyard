<!DOCTYPE html>
<html lang="en" class="h-full bg-white dark:bg-zinc-900 safe-area-x">
  <head>
    <meta charset="utf-8" />
    <%!-- maximum-scale=1 prevents iOS Safari's auto-zoom on input focus.
         On iOS 10+ this does NOT block user pinch-zoom (Apple ignores it
         for user-initiated gestures). On Android it DOES block pinch-zoom,
         but Android doesn't auto-zoom on inputs anyway, so it only matters
         on iOS where we need it. viewport-fit=cover handles notches. --%>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Boom Looper</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="h-full antialiased font-sans">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-violet-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:font-medium"
    >
      Skip to main content
    </a>
    {@inner_content}
  </body>
</html>
